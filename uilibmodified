    progressBar.Parent = notification
    
    -- Animate in
    CreateTween(notification, {Size = UDim2.new(1, 0, 0, 80)}, 0.4, Enum.EasingStyle.Back):Play()
    
    -- Progress bar animation
    wait(0.4)
    CreateTween(progressBar, {Size = UDim2.new(0, 0, 0, 3)}, duration or 3, Enum.EasingStyle.Linear):Play()
    
    -- Animate out
    wait(duration or 3)
    local tweenOut = CreateTween(notification, {
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundTransparency = 1
    }, 0.3)
    
    tweenOut.Completed:Connect(function()
        notification:Destroy()
    end)
    
    tweenOut:Play()
end

