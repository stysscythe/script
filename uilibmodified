            local hexDisplay = Instance.new("Frame")
            hexDisplay.Position = UDim2.new(0, 15, 0, 345)
            hexDisplay.Size = UDim2.new(1, -30, 0, 30)
            hexDisplay.BackgroundColor3 = Theme.Foreground
            hexDisplay.BorderSizePixel = 0
            hexDisplay.ZIndex = 101
            hexDisplay.Parent = pickerWindow
            
            ApplyCorner(hexDisplay, UDim.new(0, 6))
            ApplyStroke(hexDisplay)
            
            local hexLabel = Instance.new("TextLabel")
            hexLabel.Size = UDim2.new(1, 0, 1, 0)
            hexLabel.BackgroundTransparency = 1
            hexLabel.Font = Enum.Font.GothamMedium
            hexLabel.Text = "HEX: #FFFFFF"
            hexLabel.TextColor3 = Theme.TextPrimary
            hexLabel.TextSize = 12
            hexLabel.ZIndex = 102
            hexLabel.Parent = hexDisplay
            
            -- Color Picker Logic
            local h, s, v = 1, 1, 1
            
            local function rgbToHex(color)
                return string.format("#%02X%02X%02X", 
                    math.floor(color.R * 255),
                    math.floor(color.G * 255),
                    math.floor(color.B * 255))
            end
            
            local function updateColor()
                local color = Color3.fromHSV(h, s, v)
                currentColor = color
                colorPreview.BackgroundColor3 = color
                colorCanvas.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                
                rgbLabel.Text = string.format("RGB: %d, %d, %d",
                    math.floor(color.R * 255),
                    math.floor(color.G * 255),
                    math.floor(color.B * 255))
                
                hexLabel.Text = "HEX: " .. rgbToHex(color)
                
                if callback then
                    pcall(callback, color)
                end
            end
            
            -- Canvas Interaction
            local canvasDragging = false
            
            colorCanvas.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    canvasDragging = true
                    
                    local function update()
                        local pos = input.Position
                        local relX = math.clamp((pos.X - colorCanvas.AbsolutePosition.X) / colorCanvas.AbsoluteSize.X, 0, 1)
                        local relY = math.clamp((pos.Y - colorCanvas.AbsolutePosition.Y) / colorCanvas.AbsoluteSize.Y, 0, 1)
                        
                        s = relX
                        v = 1 - relY
                        
                        colorDot.Position = UDim2.new(relX, 0, relY, 0)
                        updateColor()
                    end
                    
                    update()
                end
            end)
            
            colorCanvas.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    canvasDragging = false
                end
            end)
            
            UserInputService.InputChanged:Connect(function(input)
                if canvasDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    local relX = math.clamp((input.Position.X - colorCanvas.AbsolutePosition.X) / colorCanvas.AbsoluteSize.X, 0, 1)
                    local relY = math.clamp((input.Position.Y - colorCanvas.AbsolutePosition.Y) / colorCanvas.AbsoluteSize.Y, 0, 1)
                    
                    s = relX
                    v = 1 - relY
                    
                    colorDot.Position = UDim2.new(relX, 0, relY, 0)
                    updateColor()
                end
            end)
            
            -- Hue Slider Interaction
            local hueDragging = false
            
            hueSlider.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    hueDragging = true
                    
                    local function update()
                        local relX = math.clamp((input.Position.X - hueSlider.AbsolutePosition.X) / hueSlider.AbsoluteSize.X, 0, 1)
                        h = relX
                        hueSelector.Position = UDim2.new(relX, 0, 0.5, 0)
                        updateColor()
                    end
                    
                    update()
                end
            end)
            
            hueSlider.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    hueDragging = false
                end
            end)
            
            UserInputService.InputChanged:Connect(function(input)
                if hueDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    local relX = math.clamp((input.Position.X - hueSlider.AbsolutePosition.X) / hueSlider.AbsoluteSize.X, 0, 1)
                    h = relX
                    hueSelector.Position = UDim2.new(relX, 0, 0.5, 0)
                    updateColor()
                end
            end)
            
            -- Open/Close Picker
            colorPreview.MouseButton1Click:Connect(function()
                pickerWindow.Visible = not pickerWindow.Visible
                pickerShadow.Visible = pickerWindow.Visible
                
                if pickerWindow.Visible then
                    CreateTween(pickerWindow, {Size = UDim2.new(0, 280, 0, 390)}, 0.4, Enum.EasingStyle.Back):Play()
                else
                    CreateTween(pickerWindow, {Size = UDim2.new(0, 0, 0, 0)}, 0.3):Play()
                end
            end)
            
            pickerClose.MouseButton1Click:Connect(function()
                pickerWindow.Visible = false
                pickerShadow.Visible = false
                CreateTween(pickerWindow, {Size = UDim2.new(0, 0, 0, 0)}, 0.3):Play()
            end)
            
            -- Initialize with default color
            if defaultColor then
                local hue, sat, val = Color3.toHSV(defaultColor)
                h, s, v = hue, sat, val
                colorDot.Position = UDim2.new(s, 0, 1 - v, 0)
                hueSelector.Position = UDim2.new(h, 0, 0.5, 0)
                updateColor()
            end
            
            return {
                SetColor = function(color)
                    local hue, sat, val = Color3.toHSV(color)
                    h, s, v = hue, sat, val
                    colorDot.Position = UDim2.new(s, 0, 1 - v, 0)
                    hueSelector.Position = UDim2.new(h, 0, 0.5, 0)
                    updateColor()
                end,
                GetColor = function()
                    return currentColor
                end
            }
        end
        
        return Tab
    end
    
    -- ═══════════════════════════════════════════════════════════
    -- WINDOW METHODS
    -- ═══════════════════════════════════════════════════════════
    
    function Window:Notify(title, message, duration)
        CreateNotification(title, message, duration)
    end
    
    function Window:Destroy()
        CreateTween(mainWindow, {
            Size = UDim2.new(0, 0, 0, 0),
            Position = UDim2.new(0.5, 0, 0.5, 0)
        }, 0.3)
        
        CreateTween(shadowContainer, {
            Size = UDim2.new(0, 0, 0, 0)
        }, 0.3).Completed:Connect(function()
            screenGui:Destroy()
        end)
    end
    
    function Window:Toggle()
        mainWindow.Visible = not mainWindow.Visible
        shadowContainer.Visible = mainWindow.Visible
    end
    
    return Window
end

return UILibrary
