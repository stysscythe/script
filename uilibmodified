                local relativeX = math.clamp((input.Position.X - sliderTrack.AbsolutePosition.X) / sliderTrack.AbsoluteSize.X, 0, 1)
                currentValue = math.floor(min + (max - min) * relativeX)
                
                sliderValue.Text = tostring(currentValue)
                CreateTween(sliderFill, {Size = UDim2.new(relativeX, 0, 1, 0)}, 0.1):Play()
                
                if callback then
                    pcall(callback, currentValue)
                end
            end
            
            sliderTrack.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    updateSlider(input)
                    CreateTween(dotShadowContainer, {Size = UDim2.new(0, 18, 0, 18)}, 0.2):Play()
                    CreateTween(sliderDot, {Size = UDim2.new(0, 18, 0, 18)}, 0.2):Play()
                end
            end)
            
            sliderTrack.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                    CreateTween(dotShadowContainer, {Size = UDim2.new(0, 14, 0, 14)}, 0.2):Play()
                    CreateTween(sliderDot, {Size = UDim2.new(0, 14, 0, 14)}, 0.2):Play()
                end
            end)
            
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    updateSlider(input)
                end
            end)
            
            AddHoverEffect(sliderFrame)
            
            return {
                SetValue = function(value)
                    currentValue = math.clamp(value, min, max)
                    sliderValue.Text = tostring(currentValue)
                    local relativeX = (currentValue - min) / (max - min)
                    CreateTween(sliderFill, {Size = UDim2.new(relativeX, 0, 1, 0)}, 0.2):Play()
                end
            }
        end
        
